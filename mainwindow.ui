    <property name="styleSheet">
     <string notr="true">QTabWidget:pane {
border: 1px solid gray;
}
QTabWidget::pane {
  border: 1px solid lightgray;
  top:-1px; 
  background:rgb(0, 170, 255); 
} 

QTabBar::tab {
  background:rgb(255, 0, 0); 
  border: 1px rgb(0, 85, 255); 
  padding: 15px;
} 

QTabBar::tab:selected { 
  background: rgb(245, 245, 245); 
  margin-bottom: -1px; 
}
QTabWidget {  
    background-color:#B6D7A8;
    border-top: 2px solid #B6D7A8;  
} 
QTabWidget::pane { /* The tab widget frame */  
    border-top: 3px solid #B6D7A8;  
} 
 /* Style the tab using the tab sub-control. Note that 
    it reads QTabBar _not_ QTabWidget */  
QTabBar::tab {  
    background-color:#0f2033;
    border: 1px solid #B6D7A8;  
    min-width: 150px; 
    min-height:22px;
    padding: 0px  2px; 
    color: rgb(255, 255, 255);
    margin-left: 1px;
    font: 75 10pt &quot;Berlin Sans FB&quot;;
}  
  
QTabBar::tab:selected, QTabBar::tab:hover {  
    background-color:#397465;
    margin-top: 0px;
    
}  
  

  
QTabBar::tab:!selected {  
    /*margin-top: 5px;  make non-selected tabs look smaller */  
}  

